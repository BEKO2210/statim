# systemd unit for the Statim decision server.
#   install -Dm755 build/statim /usr/local/bin/statim
#   install -Dm644 model.gguf /var/lib/statim/multilingual.gguf
#   echo 'STATIM_API_KEY=change-me' > /etc/statim/env && chmod 600 /etc/statim/env
#   systemctl enable --now statim
[Unit]
Description=Statim System-1 decision server
Documentation=https://github.com/BEKO2210/statim
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=STATIM_API_KEY=
EnvironmentFile=/etc/statim/env
ExecStart=/usr/local/bin/statim serve -m multilingual=/var/lib/statim/multilingual.gguf --host 127.0.0.1 --port 8080 --workers 2
# Allow in-flight requests to complete on SIGTERM up to the 120 s inference timeout,
# plus 30 s headroom for network flush and clean exit, before systemd issues SIGKILL.
TimeoutStopSec=150
Restart=on-failure
RestartSec=2
DynamicUser=yes
StateDirectory=statim
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
LimitNOFILE=4096
MemoryHigh=6G
MemoryMax=8G
CPUQuota=400%
TasksMax=256

[Install]
WantedBy=multi-user.target
